{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PULL Pattern",
  "type": "object",
  "required": [
    "pattern_id",
    "state",
    "supporting_anecdote_ids",
    "recurring_project",
    "strongest_rival_explanation",
    "falsification_queue_ids",
    "revision",
    "impact_state"
  ],
  "properties": {
    "pattern_id": {
      "type": "string",
      "pattern": "^PP-"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "enum": [
        "candidate",
        "challenged",
        "supported",
        "split",
        "rejected",
        "stale"
      ]
    },
    "supporting_anecdote_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependent_case_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "recurring_actor_state": {
      "type": "string"
    },
    "recurring_project": {
      "type": "string"
    },
    "recurring_forcing_condition": {
      "type": "string"
    },
    "recurring_commitment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurring_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurring_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurring_transaction_path": {
      "type": "string"
    },
    "recurring_acceptance_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strongest_rival_explanation": {
      "type": "string"
    },
    "falsification_queue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_for_state": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_state": {
      "enum": [
        "current",
        "needs_review",
        "stale"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ]
      }
    },
    "status_note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}