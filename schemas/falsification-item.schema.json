{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Falsification Queue Item",
  "type": "object",
  "required": [
    "schema_version",
    "item_id",
    "pattern_id",
    "target_uncertainty",
    "pattern_claim_at_risk",
    "evidence_source",
    "collection_action",
    "supporting_result",
    "disconfirming_result",
    "priority_rationale",
    "revision",
    "impact_state",
    "status",
    "created_at",
    "updated_at",
    "updated_by",
    "revision_note",
    "sampling_instruction"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^FQ-[0-9]{8}-[A-Za-z0-9]{6,}$"
    },
    "pattern_id": {
      "type": "string",
      "minLength": 1
    },
    "target_uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "pattern_claim_at_risk": {
      "type": "string",
      "minLength": 1
    },
    "evidence_source": {
      "type": "string",
      "minLength": 1
    },
    "collection_action": {
      "type": "string",
      "minLength": 1
    },
    "supporting_result": {
      "type": "string",
      "minLength": 1
    },
    "disconfirming_result": {
      "type": "string",
      "minLength": 1
    },
    "sampling_instruction": {
      "type": "string"
    },
    "priority_rationale": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "collecting",
        "resolved",
        "blocked"
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_state": {
      "enum": [
        "current",
        "needs_review",
        "stale"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": 1
    },
    "revision_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}