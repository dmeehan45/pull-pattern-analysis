{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Packet",
  "type": "object",
  "required": [
    "evidence_id",
    "revision",
    "source_reference",
    "source_date",
    "source_type",
    "actor_id",
    "episode_id",
    "summary",
    "observed_actions",
    "counterevidence",
    "unknowns",
    "status",
    "privacy_state",
    "excerpts",
    "resource_movement",
    "options",
    "relations"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{8}-[A-Za-z0-9]{6,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_reference": {
      "type": "string"
    },
    "source_date": {
      "type": "string",
      "format": "date"
    },
    "source_type": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "episode_id": {
      "type": "string"
    },
    "preprocessed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_for_positive_signal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1600
    },
    "excerpts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "observed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_information": {
      "type": "object",
      "properties": {
        "project_became_active": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_or_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "delay_consequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "forcing_condition_expired": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "resource_movement": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string"
          },
          "state": {
            "enum": [
              "used",
              "evaluating",
              "rejected",
              "mentioned",
              "unknown"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "option",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "transaction_evidence": {
      "type": "object",
      "properties": {
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    "source_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional non-sensitive fingerprint for duplicate detection. Do not derive by embedding confidential source content."
    },
    "ingested_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy_state": {
      "enum": [
        "redacted",
        "private_approved",
        "public_safe",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "superseded",
        "withdrawn"
      ]
    }
  },
  "additionalProperties": false
}