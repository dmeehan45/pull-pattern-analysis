{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Packet",
  "type": "object",
  "required": [
    "evidence_id",
    "revision",
    "source_reference",
    "source_date",
    "source_type",
    "actor_id",
    "episode_id",
    "summary",
    "observed_actions",
    "counterevidence",
    "unknowns"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_reference": {
      "type": "string"
    },
    "source_date": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "episode_id": {
      "type": "string"
    },
    "preprocessed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_for_positive_signal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "excerpts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "observed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_information": {
      "type": "object",
      "properties": {
        "project_became_active": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_or_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "delay_consequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "forcing_condition_expired": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "resource_movement": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string"
          },
          "state": {
            "enum": [
              "used",
              "evaluating",
              "rejected",
              "mentioned",
              "unknown"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "option",
          "state"
        ]
      }
    },
    "transaction_evidence": {
      "type": "object",
      "properties": {
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ]
      }
    }
  }
}