{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PULL Anecdote",
  "type": "object",
  "required": [
    "schema_version",
    "anecdote_id",
    "actor_id",
    "observed_at",
    "project",
    "forcing_condition",
    "existing_commitment",
    "current_options",
    "acceptance_boundary",
    "observable_next_commitment",
    "evidence_classification",
    "revision",
    "impact_state",
    "source_ids",
    "status",
    "created_at",
    "updated_at",
    "updated_by",
    "revision_note"
  ],
  "properties": {
    "anecdote_id": {
      "type": "string",
      "pattern": "^PA-[0-9]{8}-[A-Za-z0-9]{6,}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accepted evidence packet IDs (EV-*), not raw source blobs.",
      "minItems": 1,
      "uniqueItems": true
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "collection_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_for_positive_signal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "actor_state": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "forcing_condition": {
      "type": "string",
      "minLength": 1
    },
    "time_boundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "delay_consequence": {
      "type": [
        "string",
        "null"
      ]
    },
    "existing_commitment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "option",
          "status"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "status": {
            "enum": [
              "used",
              "actively_evaluated",
              "considered_rejected",
              "mentioned",
              "unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "transaction_path": {
      "type": "object",
      "properties": {
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observable_next_commitment": {
      "type": "string",
      "minLength": 1
    },
    "expected_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_classification": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "observed",
          "reported",
          "inferred",
          "unknown",
          "contradicted"
        ]
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_state": {
      "enum": [
        "current",
        "needs_review",
        "stale"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "revision_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}