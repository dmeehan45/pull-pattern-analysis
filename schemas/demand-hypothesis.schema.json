{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demand Hypothesis",
  "type": "object",
  "required": [
    "hypothesis_id",
    "as_of",
    "actor_segment",
    "project",
    "forcing_condition",
    "existing_commitment",
    "current_options",
    "blocking_limitations",
    "acceptance_boundary",
    "observable_next_commitment",
    "falsification_conditions",
    "revision",
    "impact_state",
    "status",
    "derived_from_pattern_ids",
    "transaction_path",
    "canonical_statement"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^DH-[0-9]{8}-[A-Za-z0-9]{6,}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "derived_from_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actor_segment": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "forcing_condition": {
      "type": "string"
    },
    "time_boundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "existing_commitment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transaction_path": {
      "type": "string"
    },
    "acceptance_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observable_next_commitment": {
      "type": "string"
    },
    "next_commitment_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "falsification_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_statement": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_state": {
      "enum": [
        "current",
        "needs_review",
        "stale"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "supports",
              "contradicts",
              "qualifies",
              "duplicates",
              "same_episode",
              "supersedes",
              "split_from",
              "tests"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "challenged",
        "rejected",
        "superseded",
        "stale"
      ]
    }
  },
  "additionalProperties": false
}